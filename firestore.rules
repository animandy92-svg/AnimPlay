rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isHost(pin) {
      return signedIn() && get(/databases/$(database)/documents/games/$(pin)).data.hostUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;

      match /{document=**} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']) &&
          request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
          request.resource.data.memberUids.hasAny([request.auth.uid])
        )
      );
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completions'])
      );
    }

    match /games/{pin} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /players/{playerId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authUid == request.auth.uid;
        allow update: if isHost(pin) || (
          signedIn() && resource.data.authUid == request.auth.uid &&
          request.resource.data.authUid == request.auth.uid &&
          request.resource.data.score == resource.data.score &&
          request.resource.data.correct == resource.data.correct &&
          request.resource.data.streak == resource.data.streak
        );
        allow delete: if isHost(pin) || (signedIn() && resource.data.authUid == request.auth.uid);
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
